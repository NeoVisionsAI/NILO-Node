# Copy to .env in the install directory (deploy.sh creates it on first install).
# Never commit .env with real secrets.

# --- Deploy (optional) ---
# Pull pre-built image instead of building from source:
# NILO_IMAGE=ghcr.io/neovisions/nilo-node:latest
# NILO_REPO=https://github.com/NeoVisions/NILO-Node.git
# NILO_REPO_BRANCH=main
# NILO_INSTALL_DIR=/opt/nilo-node

# --- NILO-Node secrets (required in production) ---
NILO_LOCAL_API_TOKEN=
# Portal /setup/ — synced on deploy to node uuid8 + NILO_WIFI_PASSWORD
NILO_SETUP_USERNAME=
NILO_SETUP_PASSWORD=
NILO_BACKEND_API_KEY=
NILO_BACKEND_CLIENT_ID=
NILO_BACKEND_CLIENT_SECRET=
NILO_WIFI_PASSWORD=
# Clave WiFi del router doméstico (para reconectar automáticamente al BSSID 2.4 GHz)
WIFI_ROUTER_PASSWORD=
NILO_MQTT_USERNAME=
NILO_MQTT_PASSWORD=
